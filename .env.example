# TODO: Resend API key for the contact form. Read at request time. Do not commit a real key.
RESEND_API_KEY=

# Inbox that receives contact form messages. Read at request time.
CONTACT_TO_EMAIL=techtonic.innov@gmail.com

# Sender Resend uses for the contact form. Resend requires this, and it must be
# an address on a domain verified in that Resend account. Read at request time.
# No verified domain was provided. Leave this empty until one exists.
# A missing value makes the form show its error state. Do not commit a secret.
RESEND_FROM_EMAIL=

# Optional Google Calendar appointment-schedule URL. When this is a real https URL,
# the contact section embeds it. When empty, visitors pick a time and open a
# Google Calendar template in their own account. Do not invent a URL.
NEXT_PUBLIC_BOOKING_URL=

# TODO: Canonical production origin for metadata, Open Graph, and the sitemap. No domain was provided.
NEXT_PUBLIC_SITE_URL=
